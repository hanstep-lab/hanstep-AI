# OCR Worker(ocr/worker) 설정. ocr/.env로 복사해서 쓴다(커밋하지 않는다).
# compose(docker compose --profile ocr up -d --build ocr-worker)에서는 루트 .env의
# RABBITMQ_URL(컨테이너 주소 rabbitmq:5672)과 SPRING_INTERNAL_API_URL이 이 파일보다 우선한다.
# 호스트에서 직접 실행(python -m worker)할 때만 아래 두 줄의 주석을 풀어 호스트 주소를 쓴다.
# RABBITMQ_URL=amqp://hanstep:CHANGE_ME_RABBIT_PASSWORD@localhost:5672/%2F
# SPRING_INTERNAL_API_URL=http://localhost:8080

# AI/Worker -> Spring 내부 API 키(X-Internal-Token). Spring의 내부 API 키와 같은 값.
SPRING_INTERNAL_API_KEY=CHANGE_ME_SPRING_INTERNAL_API_KEY

# R2: 등록증 원본(ARC) 버킷 읽기 전용 키. 정책 버킷 키(ai/.env의 R2_ACCESS_KEY_ID)와 다른 키를 쓴다.
# 엔드포인트는 버킷 이름·경로 없이 계정 주소만 쓴다.
R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_OCR_ACCESS_KEY_ID=CHANGE_ME_R2_OCR_ACCESS_KEY_ID
R2_OCR_SECRET_ACCESS_KEY=CHANGE_ME_R2_OCR_SECRET_ACCESS_KEY
R2_ARC_BUCKET=hanstep-arc-private

# 일시 오류 재시도 대기(ms). 값 개수가 최대 재시도 횟수다.
RETRY_DELAYS_MS=5000,15000,45000
# job_started의 workerId. 비우면 ocr-worker-<호스트 이름>.
WORKER_ID=
