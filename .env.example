# Copy to .env at the project root and replace example passwords.
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=hanstep

RABBITMQ_DEFAULT_USER=hanstep
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBIT_PASSWORD
# Must match the credentials above. Percent-encode username/password in this URL.
# Use the service name rabbitmq, not localhost, inside containers.
RABBITMQ_URL=amqp://hanstep:CHANGE_ME_RABBIT_PASSWORD@rabbitmq:5672/%2F

AI_PORT=8000
MONGODB_PORT=27017
MONGODB_USER=hanstep
MONGODB_PASSWORD=CHANGE_ME_MONGO_PASSWORD
# Match the credentials above; percent-encode username/password in this URL.
# Compose overrides ai/.env MONGO_URI with this container connection string.
MONGO_URI=mongodb://hanstep:CHANGE_ME_MONGO_PASSWORD@mongodb:27017/?authSource=admin&directConnection=true
# Spring is assumed to run on the host, outside this Compose project.
SPRING_INTERNAL_API_URL=http://host.docker.internal:8080
