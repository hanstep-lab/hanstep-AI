# AI compose settings (docker-compose.yml). Copy to .env at the project root.
# Infrastructure (MySQL, RabbitMQ, MongoDB) is defined in the backend repository's compose;
# use the same credentials as the backend .env in the URIs below.

AI_PORT=8000

# Container addresses on the shared network "hanstep-net" (service names, not localhost).
# Percent-encode username/password in these URIs.
MONGO_URI=mongodb://hanstep:CHANGE_ME_MONGO_PASSWORD@mongodb:27017/?authSource=admin&directConnection=true
RABBITMQ_URL=amqp://hanstep:CHANGE_ME_RABBIT_PASSWORD@rabbitmq:5672/%2F
# Spring runs on the host, outside Compose.
SPRING_INTERNAL_API_URL=http://host.docker.internal:8080
LOAD_MODEL_ON_STARTUP=true

# ---- compose.full.yml only (one-command start with ../hanstep-backend) ----
# The backend compose reads these from this file when included. Keep them equal to the
# backend .env and to the URIs above.
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=hanstep
RABBITMQ_DEFAULT_USER=hanstep
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBIT_PASSWORD
MONGODB_PORT=27017
MONGODB_USER=hanstep
MONGODB_PASSWORD=CHANGE_ME_MONGO_PASSWORD
