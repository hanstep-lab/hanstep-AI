# ==========================================
# MongoDB Atlas Vector Search
# ==========================================
# Host execution: cloud Atlas URI below, or localhost:27017 for Atlas Local.
# Compose overrides MONGO_URI using the root .env (mongodb:27017).
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGO_DATABASE=shinhan_rag
MONGO_VECTOR_INDEX=rag_vector_index

# ==========================================
# Anthropic Claude / LLM
# ==========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
AGENT_MODEL=claude-sonnet-4-6

# ==========================================
# Embedding (BGE-M3)
# ==========================================
EMBEDDING_MODEL=BAAI/bge-m3

# ==========================================
# RabbitMQ
# ==========================================
# Compose overrides this using the root .env (rabbitmq:5672).
RABBITMQ_URL=amqp://shinhan:your-password@localhost:5672/

# ==========================================
# Spring Boot Internal API
# ==========================================
# Compose overrides the URL for Spring running on the host.
SPRING_INTERNAL_API_URL=http://localhost:8080
SPRING_INTERNAL_API_KEY=your-internal-api-key

# ==========================================
# Cloudflare R2 Object Storage
# ==========================================
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_REGION=auto

# R2 Buckets
R2_POLICY_BUCKET=shinhan-visa-policies
R2_ARC_BUCKET=shinhan-arc-private

# ==========================================
# Application
# ==========================================
APP_ENV=local
LOG_LEVEL=INFO

