# ==========================================
# MongoDB Atlas Vector Search
# ==========================================
# Host execution: localhost for Atlas Local; replace with your Atlas URI for cloud use.
# Compose overrides MONGO_URI using the root .env (mongodb:27017).
# Match the local MongoDB password; percent-encode credentials in connection URIs.
MONGO_URI=mongodb://hanstep:CHANGE_ME_MONGO_PASSWORD@localhost:27017/?authSource=admin&directConnection=true
MONGO_DATABASE=shinhan_rag
MONGO_COLLECTION=visa_policy_chunks
MONGO_VECTOR_INDEX=rag_vector_index
# ==========================================
# Anthropic Claude / LLM
# ==========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
AGENT_MODEL=claude-haiku-5-5
# ==========================================
# Chat agent (INT-05)
# ==========================================
# fake: API 키 없이 같은 그래프를 도는 가짜 모델 | anthropic: 실제 호출
CHAT_LLM_MODE=fake
# 챗봇 전용 모델. 비우면 AGENT_MODEL을 쓴다
CHAT_MODEL=
# model_default(thinking 파라미터를 보내지 않음, 두 5.5 모델 모두 adaptive) | adaptive | between_tools | disabled
# Sonnet 5.5는 disabled 불가, Haiku 5.5는 between_tools 불가(둘 다 effort high 이하)
CHAT_THINKING=model_default
# 비움(모델 기본) | low | medium | high
CHAT_EFFORT=
# thinking 토큰도 max_tokens에 포함된다
CHAT_MAX_TOKENS=2000
CHAT_MAX_TOOL_CALLS=3
CHAT_TOOL_TIMEOUT_SECONDS=5
CHAT_RUN_TIMEOUT_SECONDS=60
CHAT_FAKE_DELTA_DELAY_MS=30
# true면 금융 도구 결과에 코드가 계산한 판단 근거(judgmentFacts)를 넣는다
CHAT_JUDGMENT_FACTS=false
# 시스템 프롬프트 버전 v1 | v1.1 (v1.1: 판단 근거 숫자 사용과 과거 평균 기준 판단 허용)
CHAT_PROMPT_VERSION=v1
# 측정 전용: true일 때만 X-Chat-Config 헤더로 요청마다 model·thinking·effort·maxTokens·judgmentFacts·promptVersion 변경
CHAT_ALLOW_CONFIG_OVERRIDE=false
# ==========================================
# Embedding (BGE-M3)
# ==========================================
EMBEDDING_MODEL=BAAI/bge-m3
# Pin a Hugging Face commit hash for reproducible embeddings; empty uses the default branch.
# 팀원 모두 같은 값을 써야 한다. 적재 시 Spring에 embedding_model@revision으로 기록되며,
# 값을 바꾸면 저장된 청크를 전부 다시 임베딩해야 한다.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# Set true when running search that requires a loaded model.
LOAD_MODEL_ON_STARTUP=false
# ==========================================
# RabbitMQ
# ==========================================
# Compose overrides this using the root .env (rabbitmq:5672).
# Match the local RabbitMQ password; percent-encode credentials.
RABBITMQ_URL=amqp://hanstep:CHANGE_ME_RABBIT_PASSWORD@localhost:5672/%2F
# ==========================================
# Spring Boot Internal API (AI -> Spring)
# ==========================================
# Compose overrides the URL for Spring running on the host.
SPRING_INTERNAL_API_URL=http://localhost:8080
SPRING_INTERNAL_API_KEY=
# ==========================================
# BE -> AI internal API (/internal/v1/...)
# ==========================================
# Shared token Spring sends to AI. Must differ from SPRING_INTERNAL_API_KEY.
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_INTERNAL_API_TOKEN=
INTERNAL_TOKEN_HEADER=X-Internal-Token
# ==========================================
# Cloudflare R2 Object Storage
# ==========================================
# Replace CHANGE_ME_ACCOUNT_ID with your Cloudflare account ID.
# S3 endpoint only: do not append a bucket name or object path.
R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
# RAG credentials: Object Read & Write for the policy and product buckets only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 비자 정책 원문 — 비공개
R2_POLICY_BUCKET=hanstep-visa-policies
# 금융상품 설명서·약관 원문 — 비공개
R2_PRODUCT_BUCKET=hanstep-financial-products
# Object key prefix for policy originals (proposal; confirm with backend).
R2_POLICY_PREFIX=policy-sources
# OCR credentials: separate token scoped only to the ARC bucket.
# The OCR client must explicitly load these credentials instead of the RAG credentials.
R2_OCR_ACCESS_KEY_ID=
R2_OCR_SECRET_ACCESS_KEY=
# 외국인등록증 이미지 — 비공개, RAG 수집 대상 제외
R2_ARC_BUCKET=hanstep-arc-private
# ==========================================
# 법제처 국가법령정보 공동활용 API
# ==========================================
# The client appends /DRF/lawSearch.do or /DRF/lawService.do.
LAW_API_BASE_URL=https://www.law.go.kr
LAW_API_OC=
# ==========================================
# E-7-4 점수 계산
# ==========================================
# 승인 전(DRAFT) 규칙 버전도 계산에 쓸지. 운영은 false, 로컬·시연에서만 true.
E74_INCLUDE_DRAFT_RULES=false
# 로드맵 단계 문장을 LLM(AGENT_MODEL)으로 쓸지. false거나 키가 없으면 템플릿 문장.
ROADMAP_LLM_TEXT=false
# 문장 생성 전체(재시도 포함) 시간. Spring 호출 타임아웃보다 짧게.
ROADMAP_LLM_TIMEOUT_SECONDS=15
# ==========================================
# Application
# ==========================================
APP_ENV=local
LOG_LEVEL=INFO
